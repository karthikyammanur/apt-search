# App access
APP_PASSWORD=

# Database. Local dev uses file:data/dev.db. On Vercel the Turso integration sets TURSO_DATABASE_URL and
# TURSO_AUTH_TOKEN, which the app reads automatically (only on Vercel). Do not set DATABASE_URL on Vercel.
# For db:migrate, db:seed and gtfs against Turso, set DATABASE_URL and DATABASE_AUTH_TOKEN in the shell
# only, never in a file (see docs/deploy.md).
DATABASE_URL=file:data/dev.db
DATABASE_AUTH_TOKEN=

# AI models (all free tiers, no card)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
SAMBANOVA_API_KEY=
ZAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# Maps and transit. The Google Maps Demo Key is for local use only: its terms forbid production use, so
# the app never calls Google on Vercel production. Do not add it to the Vercel project.
GOOGLE_MAPS_DEMO_KEY=
TRAVELTIME_APP_ID=
TRAVELTIME_API_KEY=
TRANSITLAND_API_KEY=
GEOAPIFY_API_KEY=
ORS_API_KEY=
API_511_TOKEN=

# Listings and data
RENTCAST_API_KEY=
HUD_API_TOKEN=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Optional, off by default (scrapes Craigslist, against its terms)
ENABLE_APIFY=false
APIFY_TOKEN=

# Extension capture: any long random string. The extension sends it as X-Capture-Token
CAPTURE_TOKEN=

# Vercel Cron: any random string of 16+ characters. Vercel sends it as "Authorization: Bearer <value>"
CRON_SECRET=
